# Copia este archivo a .env y complétalo (nunca subas .env real a git).
# Sin esta key, la app funciona en modo heurístico (extracción por keywords) —
# es funcional pero menos matizado que Claude. Al agregarla, el pipeline cambia
# automáticamente a Claude API sin tocar código.
ANTHROPIC_API_KEY=

# Opcional: cambia la clave de sesión de Flask en un entorno compartido.
FLASK_SECRET_KEY=
